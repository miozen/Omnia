#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

OMNIA_CONFIG="/etc/omnia/runtime/config.json"
OMNIA_BIN="/usr/bin/sing-box"

start_service() {
	if [ ! -x "$OMNIA_BIN" ]; then
		echo "sing-box binary not found: $OMNIA_BIN" >&2
		return 1
	fi

	if [ ! -f "$OMNIA_CONFIG" ]; then
		echo "runtime config not found: $OMNIA_CONFIG" >&2
		return 1
	fi

	procd_open_instance omnia
	procd_set_param command "$OMNIA_BIN" run -c "$OMNIA_CONFIG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger omnia
}
